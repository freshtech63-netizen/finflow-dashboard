rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownedByUser() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function newRecordBelongsToUser() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{collection}/{documentId} {
      allow read, update, delete: if collection in ['wallets', 'transactions', 'savingsGoals', 'expenses', 'invoices', 'subscriptions'] && ownedByUser();
      allow create: if collection in ['wallets', 'transactions', 'savingsGoals', 'expenses', 'invoices', 'subscriptions'] && newRecordBelongsToUser();
    }
  }
}