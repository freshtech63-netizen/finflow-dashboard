rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownedByUser() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function newRecordBelongsToUser() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /{collection}/{documentId} {
      allow read, delete: if collection in ['wallets', 'transactions', 'savingsGoals', 'expenses', 'invoices', 'subscriptions', 'recurringPayments', 'messages', 'notifications'] && ownedByUser();
      allow create: if collection in ['wallets', 'transactions', 'savingsGoals', 'expenses', 'invoices', 'subscriptions', 'recurringPayments', 'messages', 'notifications'] && newRecordBelongsToUser();
      allow update: if collection in ['wallets', 'transactions', 'savingsGoals', 'expenses', 'invoices', 'subscriptions', 'recurringPayments', 'messages', 'notifications'] && ownedByUser() && newRecordBelongsToUser();
    }
  }
}